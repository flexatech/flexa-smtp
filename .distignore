/.git
/.github
/.gitignore
/.gitattributes
/.editorconfig
/.distignore
/.claude
/.idea
/.vscode
/.DS_Store
/node_modules
/vendor
# The admin app under apps/ is TypeScript/CSS source only; the production build
# is compiled into assets/dist/, so nothing from apps/ is needed at runtime. The
# readable source is linked from readme.txt (public repo) for Plugin Check 21.
/apps
/tests
/docs
/release.sh
/makepot.sh
/composer.json
/composer.lock
/pnpm-lock.yaml
/package-lock.json
/yarn.lock
/package.json
/pnpm-workspace.yaml
/tsconfig.json
/phpcs.xml.dist
/phpstan.neon
/phpstan-bootstrap.php
/phpunit.xml
/scripts
/stubs
/i18n/extracted-strings.js
/.eslintrc*
/.prettierrc*
# No markdown ships in a production build (WordPress reads readme.txt); this
# also keeps stray dev notes (plan, session logs) out of the zip so Plugin
# Check's root-markdown scan stays clean.
*.md
# No compile source in the zip (the built bundle lives in assets/dist/).
*.ts
*.tsx
# Regeneratable tooling caches (hidden files Plugin Check rejects).
.phpunit.result.cache
.phpcs.cache
**/*.map
**/*.log
**/.DS_Store
**/.gitkeep
