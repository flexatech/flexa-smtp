# Dependencies (regenerated via composer install / pnpm install)
/vendor/
/node_modules/

# Build output (regenerated by `pnpm build` / release.sh)
/assets/dist/

# Dev-mode marker: forces Enqueue to load from the Vite dev server
/apps/admin/.dev

# Transient makepot shim (emitted then deleted by makepot.sh)
/i18n/extracted-strings.js

# Distribution artifacts
/*.zip
/build/
/dist/

# Tooling caches
.phpunit.result.cache
.phpcs.cache
/.phpstan/
*.tsbuildinfo
/apps/admin/node_modules/
.vite/

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo
/.idea/
/.vscode/

# Keep lock files in VCS for reproducible builds:
# composer.lock and pnpm-lock.yaml are intentionally NOT ignored.
